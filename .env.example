# ===== SUPABASE (bắt buộc) =====
# Lấy tại: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ===== BẢO MẬT (tự đặt chuỗi ngẫu nhiên dài, không chia sẻ) =====
SESSION_SECRET=
ADMIN_PASSWORD=
CRON_SECRET=

# ===== ỨNG DỤNG =====
# URL công khai của app
APP_URL=http://localhost:3300
# Chế độ dev: API gửi OTP trả luôn mã trong response để test (đặt false khi chạy thật)
OTP_DEV_MODE=true

# ===== ĐĂNG NHẬP BẰNG GOOGLE (không bắt buộc — để trống thì ẩn nút Google, vẫn đăng nhập bằng SĐT) =====
# Google Cloud Console > APIs & Services > Credentials > Create credentials > OAuth client ID > loại "Web application".
# Authorized JavaScript origins: https://top.taki.vn (và http://localhost:3300 để chạy thử). KHÔNG cần client secret.
# Lần đầu phải cấu hình "OAuth consent screen" (loại External, bấm Publish app để mọi tài khoản Google đăng nhập được).
GOOGLE_CLIENT_ID=

# ===== CHỐNG GIAN LẬN =====
# Kênh bị gắn cờ khi: follower tăng ngày > FRAUD_MULTIPLIER × trung bình 7 ngày
# VÀ tỷ lệ tương tác/follower < FRAUD_ENGAGEMENT_RATIO
FRAUD_MULTIPLIER=5
FRAUD_ENGAGEMENT_RATIO=0.01
