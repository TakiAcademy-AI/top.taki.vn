{
  "manifest_version": 3,
  "name": "TAKI — Quét kênh TikTok",
  "version": "1.0.0",
  "description": "Quét số liệu kênh TikTok bằng Chrome thật rồi đẩy về hệ thống Đua Top Xây Kênh.",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["https://www.tiktok.com/*", "https://*.tiktok.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TAKI — Quét kênh TikTok"
  }
}
